{
  "name": "peek",
  "version": "0.1.0",
  "private": true,
  "description": "Local desktop context assistant with an Obsidian library",
  "author": "Peek contributors",
  "repository": { "type": "git", "url": "https://github.com/MungbPro/peek.git" },
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && node scripts/build.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:smoke": "node scripts/smoke.mjs",
    "package:mac:arm64": "npm run build && electron-builder --mac --arm64 --publish never",
    "package:mac:x64": "npm run build && electron-builder --mac --x64 --publish never"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "dotenv": "16.6.1",
    "koffi": "3.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "electron": "30.5.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "playwright": "^1.56.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "8.3.5"
  },
  "license": "MIT"
}
